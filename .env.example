# Keep real secrets in an ignored .env file locally, and Secret Manager in GCP.
OPENAI_MODEL_PRIMARY=gpt-5.6-terra
# Set only in an ignored local .env file or inject from Secret Manager in Cloud Run.
# OPENAI_API_KEY=replace_with_local_development_key
LLM_ENABLED=false
REACT_TOOL_CALLS_ENABLED=false
NOTIFICATIONS_ENABLED=false
APPROVAL_ACTIONS_ENABLED=false
MEMORY_READS_ENABLED=true
MEMORY_WRITES_ENABLED=true
APP_ENV=development
# PostgreSQL backend: postgresql+asyncpg://routeshield:local-only@127.0.0.1:5432/routeshield
DATABASE_URL=
REDIS_URL=
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
# Set true in every deployed environment. Local tests may use the compatibility
# headers until an OIDC development issuer is available.
REQUIRE_OIDC=false
API_RATE_LIMIT=60
API_RATE_LIMIT_WINDOW_SECONDS=60
# Production requires the shared Redis limiter and fails closed when it is unavailable.
RATE_LIMIT_REDIS_REQUIRED=false
IDEMPOTENCY_TTL_SECONDS=86400
REQUIRE_IDEMPOTENCY=false
TENANT_AUTOMATION_ENABLED=true
DEMO_EVIDENCE_ENABLED=true
# Claim names are configurable to match the approved corporate OIDC mapping.
OIDC_ACTOR_ID_CLAIM=sub
OIDC_TENANT_ID_CLAIM=tenant_id
OIDC_ROLE_CLAIM=role
RETENTION_DAYS=90
# Live providers are individually fail-closed until their URL/secret configuration is supplied.
PROVIDER_AMADEUS_ENABLED=false
PROVIDER_FAA_ENABLED=false
PROVIDER_NWS_ENABLED=false
PROVIDER_AVIATION_WEATHER_ENABLED=false
PROVIDER_GOOGLE_ROUTES_ENABLED=false
PROVIDER_DESTINATION_ADVISORY_ENABLED=false
NWS_ALERTS_URL=
AMADEUS_FLIGHT_STATUS_URL=
FAA_NAS_STATUS_URL=
# AMADEUS_CLIENT_ID=development_only
# AMADEUS_CLIENT_SECRET=development_only
AVIATION_WEATHER_URL=
GOOGLE_ROUTES_URL=
DESTINATION_ADVISORY_URL=
